# Public base URL used for canonical links and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo 01 (Sen Studio) enquiry endpoint. Leave empty to keep the form in
# preview/demo mode, where nothing is sent. When set, the form POSTs JSON here.
# This must be a public endpoint (e.g. a form service URL) — never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SEN_ENQUIRY_ENDPOINT=
NEXT_PUBLIC_MALI_CONSULT_ENDPOINT=
NEXT_PUBLIC_SOI_REQUEST_ENDPOINT=
NEXT_PUBLIC_YIM_APPOINTMENT_ENDPOINT=
NEXT_PUBLIC_THARA_BOOKING_ENDPOINT=
